# Local backend. The client uses /api and the Vite dev server proxies it to this port.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional: omit GEMINI_API_KEY to use the clearly labelled offline simulation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional locally; required for persistent deployed accounts and cases.
MONGO_URI=

# Use a long random value in deployed environments. Render can generate this for you.
JWT_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
